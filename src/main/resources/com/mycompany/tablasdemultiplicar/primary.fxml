<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER"
      spacing="10.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.tablasdemultiplicar.PrimaryController">

    <children>
        <Label text="Tabla del:" />
        <TextField fx:id="num" />

        <Button fx:id="btnCalcular"
                text="Calcular"
                onAction="#btnCalcular_click"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#btnLimpiar_click"/>

        <Label fx:id="lbl1" text="" />
        <Label fx:id="lbl2" text="" />
        <Label fx:id="lbl3" text="" />
        <Label fx:id="lbl4" text="" />
        <Label fx:id="lbl5" text="" />
        <Label fx:id="lbl6" text="" />
        <Label fx:id="lbl7" text="" />
        <Label fx:id="lbl8" text="" />
        <Label fx:id="lbl9" text="" />
        <Label fx:id="lbl10" text="" />
    </children>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>